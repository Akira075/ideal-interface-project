 "faq": [
  {
   "id": "f1",
   "q": "Как пройти тест?",
   "a": "Откройте раздел «Все тесты», выберите тест и нажмите «Начать». Результат появится сразу после завершения."
  },
  {
   "id": "f2",
   "q": "Сколько попыток у меня есть?",
   "a": "Количество попыток задаёт автор теста. Оно указано на карточке теста."
  },
  {
   "id": "f3",
   "q": "Как попасть в группу?",
   "a": "Попросите учителя или администратора добавить вас в группу — после этого откроются закрытые тесты."
  },
  {
   "id": "f4",
   "q": "Куда писать, если что-то сломалось?",
   "a": "В раздел «Поддержка». Создайте обращение — разработчик ответит в течение дня."
  }
